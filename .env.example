# --- required ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_from_botfather
TELEGRAM_CHAT_ID=123456789
WEBHOOK_SECRET=change-me-to-a-long-random-string

# --- optional: enables /projects and /resources ---
COOLIFY_URL=https://coolify.example.com
COOLIFY_API_TOKEN=coolify-api-token-from-keys-and-tokens

# --- optional: enables /usage ---
SENTINEL_TOKEN=sentinel-token-from-server-settings
# SENTINEL_URL defaults to http://coolify-sentinel:8888 when running on the
# Coolify Docker network; override only if you know what you're doing.
# SENTINEL_URL=http://coolify-sentinel:8888

PORT=8080
