# --- required ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_from_botfather
TELEGRAM_CHAT_ID=123456789
TELEGRAM_BOT_USERNAME=mybot
TELEGRAM_WEBHOOK_SECRET_TOKEN=long-random-string-for-telegram-webhook-header
WEBHOOK_SECRET=change-me-to-a-long-random-string

CURSOR_API_KEY=cursor_...
AGENT_WORKSPACE=/workspace

# --- Optional: Cursor agent MCP (Coolify API + Sentinel) ---
# Token needs write scope for action tools (deploy, restart, stop, start).
# COOLIFY_API_ORIGIN=http://coolify:8000
# COOLIFY_API_TOKEN=from_coolify_keys_and_tokens
# SENTINEL_BASE_URL=http://host.docker.internal:8080
# SENTINEL_TOKEN=sentinel_bearer_token

# --- HTTP ---
PORT=8080

# --- Telegram adapter: webhook (production) | polling (local) | auto ---
TELEGRAM_ADAPTER_MODE=webhook
